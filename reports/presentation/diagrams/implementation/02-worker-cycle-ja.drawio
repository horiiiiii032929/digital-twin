        </mxCell>
        <mxCell id="02-worker-cycle-ja-one-guard" parent="1" vertex="1" value="[--once 指定]" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=20;fontColor=#20364F;strokeColor=#20364F;strokeWidth=1.6;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=10;strokeColor=none;fillColor=none;align=left;spacing=0;fontStyle=0;">
          <mxGeometry as="geometry" x="372" y="717" width="230" height="32" />
        </mxCell>
        <mxCell id="02-worker-cycle-ja-code-heading" parent="1" vertex="1" value="実コード：_process_once() の処理順" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=26;fontColor=#20364F;strokeColor=#20364F;strokeWidth=1.6;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=10;strokeColor=none;fillColor=none;align=left;spacing=0;fontStyle=1;">
          <mxGeometry as="geometry" x="655" y="185" width="890" height="50" />
        </mxCell>
        <mxCell id="02-worker-cycle-ja-code" parent="1" vertex="1" value="&lt;pre style=&quot;margin:0;white-space:pre;font-family:Menlo,monospace;font-size:18px;line-height:1.45&quot;&gt;app.state.governed_autonomy_service.observe_events(limit=batch_size)&#10;await app.state.governed_autonomy_service.process_due(&#10;    worker_id=worker_id,&#10;    limit=batch_size,&#10;)&#10;app.state.proactive_outreach_service.process_due(limit=batch_size)&lt;/pre&gt;" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=18;fontColor=#20364F;strokeColor=#20364F;strokeWidth=1.6;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=10;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=Menlo;fontSize=18;">
          <mxGeometry as="geometry" x="655" y="255" width="890" height="235" />
        </mxCell>
        <mxCell id="02-worker-cycle-ja-job-detail-title" parent="1" vertex="1" value="自律ジョブ内で実際に行うこと" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=26;fontColor=#20364F;strokeColor=#20364F;strokeWidth=1.6;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=10;strokeColor=none;fillColor=none;align=left;spacing=0;fontStyle=1;">
          <mxGeometry as="geometry" x="655" y="535" width="890" height="45" />
        </mxCell>
        <mxCell id="02-worker-cycle-ja-job-detail" parent="1" vertex="1" value="期限切れを処理し、再実行予約を支援の機会に変換する。&#10;対象の機会を一時的に占有し、教材と権限を読み込む。&#10;行動の判定・内容生成・検証を行う。&#10;メッセージの配信後、ジョブ結果と次回予約を保存する。" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=23;fontColor=#20364F;strokeColor=#20364F;strokeWidth=1.6;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=10;strokeColor=none;fillColor=none;align=left;spacing=0;fontStyle=0;">
          <mxGeometry as="geometry" x="655" y="605" width="890" height="240" />
        </mxCell>
        <mxCell id="02-worker-cycle-ja-precondition" parent="1" vertex="1" value="実行条件：staging構成、ワーカー有効化。&#10;起動中は、ブラウザ操作とは別のプロセスで巡回する。" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=21;fontColor=#20364F;strokeColor=#20364F;strokeWidth=1.6;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=10;strokeColor=none;fillColor=none;align=left;spacing=0;fontStyle=0;">
          <mxGeometry as="geometry" x="655" y="876" width="890" height="84" />
        </mxCell>
        <mxCell id="02-worker-cycle-ja-foot" parent="1" vertex="1" value="既定は1回の処理終了後に30秒待機。処理時間も加わるため、厳密な30秒周期ではない。" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=22;fontColor=#20364F;strokeColor=#20364F;strokeWidth=1.6;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=10;strokeColor=none;fillColor=none;align=left;spacing=0;fontStyle=0;">
          <mxGeometry as="geometry" x="50" y="986" width="1500" height="43" />
        </mxCell>
      </root>
    </mxGraphModel>
