        <mxCell id="02-worker-cycle-ja-repeat-guard" parent="1" vertex="1" value="[--once なし]" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=20;fontColor=#20364F;strokeColor=#20364F;strokeWidth=1.6;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=10;strokeColor=none;fillColor=none;align=left;spacing=0;fontStyle=0;">
