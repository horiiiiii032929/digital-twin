          <mxGeometry as="geometry" x="60" y="610" width="725" height="135" />
        </mxCell>
        <mxCell id="n14" parent="1" vertex="1" value="Terminal records do not transition back to active.&#10;A new goal requires a new record." style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#182B43;fillColor=#ffffff;strokeColor=#182B43;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;shape=note;size=18;align=left;spacing=14;">
