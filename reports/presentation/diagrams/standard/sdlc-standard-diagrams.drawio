        </mxCell>
        <mxCell id="n16" parent="1" vertex="1" value="Notation: filled circle = initial pseudostate; rounded rectangle = state; trigger [guard] / effect. Terminal records remain persisted." style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;fontColor=#182B43;fillColor=#ffffff;strokeColor=#182B43;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;strokeColor=none;fillColor=none;align=left;spacing=0;fontStyle=0;">
