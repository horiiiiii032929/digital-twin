        </mxCell>
        <mxCell id="n15" parent="1" vertex="1" value="completionGuard: valid exact objective mapping; every target&#10;concept has ≥ 2 correct, 0 incorrect and confidence ≥ 0.5.&#10;Missing or ambiguous evidence leaves the goal active." style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#182B43;fillColor=#ffffff;strokeColor=#182B43;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=10;shape=note;size=18;align=left;spacing=14;">
