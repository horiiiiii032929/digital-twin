s matched]" vertex="1" parent="1" style="html=1;fontFamily=Arial;fontSize=19;fontColor=#182F49;strokeColor=#526478;strokeWidth=1.5;strokeColor=none;fillColor=#FFFFFF;align=left;fontSize=18;"><mxGeometry as="geometry" x="53" y="394" width="237" height="24" /></mxCell><mxCell id="26" value="7. Assemble source text + citations" vertex="1" parent="1" style="html=1;fontFamily=Arial;fontSize=19;fontColor=#182F49;strokeColor=#526478;strokeWidth=1.5;strokeColor=none;fillColor=none;align=left;fontSize=20;fontStyle=1;"><mxGeometry as="geometry" x="195" y="415" width="516" height="25" /></mxCell><mxCell id="27" value="[a topic lacks evidence]" vertex="1" parent="1" style="html=1;fontFamily=Arial;fontSize=19;fontColor=#182F49;strokeColor=#526478;strokeWidth=1.5;strokeColor=none;fillColor=#FFFFFF;align=left;fontSize=18;"><mxGeometry as="geometry" x="53" y="450" width="242" height="24" /></mxCell><mxCell id="28" value="7. Withhold the factual answer" vertex="1" parent="1" style="html=1;fontFamily=Arial;fontSize=19;fontColor=#182F49;strokeColor=#526478;strokeWidth=1.5;strokeColor=none;fillColor=none;align=left;fontSize=20;fontStyle=1;"><mxGeometry as="geometry" x="195" y="466" width="516" height="25" /></mxCell><mxCell id="29" value="" edge="1" parent="1" style="html=1;fontFamily=Arial;fontSize=19;fontColor=#182F49;strokeColor=#526478;strokeWidth=1.5;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="112" y="422" /><mxPoint as="targetPoint" x="112" y="436" /><Array as="points"><mxPoint x="165" y="422" /><mxPoint x="165" y="436" /></Array></mxGeometry></mxCell><mxCell id="30" value="" edge="1" parent="1" style="html=1;fontFamily=Arial;fontSize=19;fontColor=#182F49;strokeColor=#526478;strokeWidth=1.5;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="112" y="477" /><mxPoint as="targetPoint" x="112" y="488" /><Array as="points"><mxPoint x="