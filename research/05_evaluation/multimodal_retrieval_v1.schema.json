{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digital-twin.local/schemas/multimodal-retrieval-v1.json",
  "title": "Multimodal retrieval benchmark v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "dataset_version",
    "dataset_kind",
    "dataset_status",
    "render_policy",
    "source_assets",
    "cases"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "dataset_id": {"type": "string", "pattern": "^multimodal-retrieval-v1(-[a-z0-9-]+)?$"},
    "dataset_version": {"type": "string", "pattern": "^v[0-9]+$"},
    "dataset_kind": {"enum": ["synthetic", "private_course"]},
    "dataset_status": {"enum": ["synthetic_fixture", "researcher_review", "approved", "sealed"]},
    "render_policy": {"const": "rasterize-before-evaluation"},
    "source_assets": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source_asset"}
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bbox": {
      "type": "array",
      "prefixItems": [
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "source_asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "path", "sha256", "mime_type", "permission", "surrounding_text", "regions"],
      "properties": {
        "asset_id": {"type": "string", "pattern": "^mm-asset-[a-z0-9-]+$"},
        "path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "mime_type": {"enum": ["image/png", "image/jpeg", "image/svg+xml", "application/pdf"]},
        "permission": {"enum": ["synthetic-approved", "course-approved-local-only"]},
        "surrounding_text": {"type": "string", "maxLength": 10000},
        "source_artifact_id": {"type": "string", "minLength": 1},
        "course_id": {"type": "string", "pattern": "^(?:CS|IT)[0-9]{4}[A-Z]?$"},
        "source_document_sha256": {"$ref": "#/$defs/sha256"},
        "page": {"type": "integer", "minimum": 1},
        "derivation": {"enum": ["synthetic-source", "pdf-page-render", "image-source", "document-render", "notebook-render", "diagram-render"]},
        "regions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["region_id", "bbox", "kind"],
            "properties": {
              "region_id": {"type": "string", "pattern": "^region-[a-z0-9-]+$"},
              "bbox": {"$ref": "#/$defs/bbox"},
              "kind": {"enum": ["title", "diagram", "chart", "table", "equation", "interface", "scanned_text", "annotation", "photo"]}
            }
          }
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "split",
        "slice",
        "modality",
        "asset_id",
        "query",
        "expected_action",
        "required_claims",
        "gold_region_ids",
        "visual_dependency",
        "review"
      ],
      "properties": {
        "case_id": {"type": "string", "pattern": "^mmr1-[a-z0-9-]+-[0-9]{2}$"},
        "split": {"enum": ["development", "heldout_draft"]},
        "slice": {"enum": ["visual_answerable", "text_control", "no_evidence", "adversarial_integrity"]},
        "modality": {"enum": ["diagram", "chart", "table", "equation", "screenshot", "scanned_page", "annotation", "photo", "mixed"]},
        "asset_id": {"type": "string", "pattern": "^mm-asset-[a-z0-9-]+$"},
        "query": {"type": "string", "minLength": 12, "maxLength": 500},
        "expected_action": {"enum": ["retrieve", "abstain", "refuse"]},
        "required_claims": {"type": "array", "maxItems": 4, "items": {"type": "string", "minLength": 3, "maxLength": 300}},
        "gold_region_ids": {"type": "array", "uniqueItems": true, "maxItems": 6, "items": {"type": "string", "pattern": "^region-[a-z0-9-]+$"}},
        "visual_dependency": {"enum": ["text_sufficient", "ocr_required", "layout_required", "visual_semantics_required"]},
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "researcher_verified", "notes"],
          "properties": {
            "status": {"enum": ["synthetic_constructed", "pending", "researcher_verified", "rejected"]},
            "researcher_verified": {"type": "boolean"},
            "notes": {"type": "string", "maxLength": 500}
          }
        }
      }
    }
  }
}
