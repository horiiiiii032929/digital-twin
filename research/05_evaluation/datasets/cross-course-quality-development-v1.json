  "sources": [
    {
      "source_id": "scheduler-1",
      "course_id": "scheduler",
      "title": "Synthetic scheduling note 1",
      "version": 1,
      "text": "Aster scheduler orders ready tasks by earliest deadline. A paused task is excluded from the ready queue."
    },
    {
      "source_id": "scheduler-2",
      "course_id": "scheduler",
      "title": "Synthetic scheduling note 2",
      "version": 1,
      "text": "Aster recovery restores the last committed queue snapshot. Recovery never resubmits a task marked complete."
    },
    {
      "source_id": "ledger-1",
      "course_id": "ledger",
      "title": "Synthetic accounting note 1",
      "version": 1,
      "text": "Beryl ledger records each transfer as equal debit and credit entries. A transfer is rejected when the entries do not balance."
    },
    {
      "source_id": "ledger-2",
      "course_id": "ledger",
      "title": "Synthetic accounting note 2",
      "version": 1,
      "text": "Beryl settlement closes a batch after both participants acknowledge it. An unacknowledged batch remains pending."
    },
    {
      "source_id": "ecology-1",
      "course_id": "ecology",
      "title": "Synthetic ecology note 1",
      "version": 1,
      "text": "Cedar plots count seedlings within a fixed square boundary. Seedlings outside that boundary are excluded."
    },
    {
      "source_id": "ecology-2",
      "course_id": "ecology",
      "title": "Synthetic ecology note 2",
      "version": 1,
      "text": "Cedar sampling repeats the count at the same marked location each week. A missing weekly count is recorded as missing rather than zero."
    },
    {
      "source_id": "protocol-1",
      "course_id": "protocol",
      "title": "Synthetic protocol note 1",
      "version": 1,
      "text": "Dune receiver accepts a packet only after its checksum matches. A packet with a mismatched checksum is discarded."
    },
    {
      "source_id": "protocol-2",
      "course_id": "protocol",
      "title": "Synthetic protocol note 2",
      "version": 1,
      "text": "Dune sender retries after an acknowledgement deadline expires. A received acknowledgement cancels the pending retry."
    }
  ],
