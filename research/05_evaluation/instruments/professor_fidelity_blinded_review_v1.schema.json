{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/horiiiiii032929/digital-twin/research/05_evaluation/instruments/professor_fidelity_blinded_review_v1.schema.json",
  "title": "Professor-fidelity blinded review v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "source_run_id",
    "dataset_sha256",
    "status",
    "reviewed_at",
    "reviewer",
    "judgments"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "review_id": {
      "type": "string",
      "minLength": 1
    },
    "source_run_id": {
      "type": "string",
      "minLength": 1
    },
    "dataset_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "const": "complete"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_id",
        "role",
        "blinded_to_conditions",
        "independent_human_review"
      ],
      "properties": {
        "reviewer_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "researcher",
            "professor"
          ]
        },
        "blinded_to_conditions": {
          "const": true
        },
        "independent_human_review": {
          "type": "boolean"
        }
      }
    },
    "judgments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/judgment"
      }
    }
  },
  "$defs": {
    "dimension": {
      "enum": [
        "student_state_recognition",
        "mistake_localization",
        "guidance_and_scaffolding",
        "actionability",
        "answer_revelation_control",
        "professor_policy_alignment",
        "clarity_and_coherence",
        "tone_and_respect"
      ]
    },
    "judgment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "condition",
        "required_claim_expression",
        "supported_claim_precision",
        "citation_semantic_alignment",
        "citation_completeness",
        "presented_evidence_completeness",
        "pedagogy_dimensions"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "condition": {
          "enum": [
            "C0",
            "C1",
            "C2",
            "C3"
          ]
        },
        "required_claim_expression": {
          "type": "boolean"
        },
        "supported_claim_precision": {
          "type": "boolean"
        },
        "citation_semantic_alignment": {
          "type": "boolean"
        },
        "citation_completeness": {
          "type": "boolean"
        },
        "presented_evidence_completeness": {
          "type": "boolean"
        },
        "pedagogy_dimensions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dimension",
              "label"
            ],
            "properties": {
              "dimension": {
                "$ref": "#/$defs/dimension"
              },
              "label": {
                "enum": [
                  "fail",
                  "partial",
                  "pass"
                ]
              }
            }
          }
        }
      }
    }
  }
}
