{
  "name": "digital-twin",
  "private": true,
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "check": "npm run check:docs && npm run verify:cross-course-portfolio && npm run verify:cross-course-benchmark && npm run verify:multimodal-retrieval-instruments && npm run verify:evaluation-instruments && npm run verify:retrieval-v3-instruments && npm run verify:evaluation-results && npm run verify:profile && npm run verify:generation && npm run test:api && npm run test:web && npm run lint:web && npm run build:web",
    "check:docs": "uv run python scripts/validate_markdown_links.py",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api": "uv run uvicorn services.api.app.main:app --reload --port 8000",
    "test": "uv run pytest tests",
    "test:api": "uv run pytest tests",
    "verify:ingestion": "uv run python -m scripts.verify_local_ingestion",
    "verify:generation": "uv run python -m scripts.evaluate_generation",
    "benchmark:generation-local": "uv run python -m scripts.evaluate_generation --model ollama/gemma3:4b --json-mode --timeout-seconds 60 --max-output-tokens 600 --output reports/generated/generation-v1-gemma3-4b.json",
    "verify:profile": "uv run python -m scripts.validate_component_profile",
    "verify:cross-course-portfolio": "uv run python -m scripts.validate_cross_course_portfolio",
    "audit:cross-course-ingestion": "uv run python -m scripts.audit_cross_course_ingestion --output reports/generated/cross-course-ingestion-v1.json",
    "draft:cross-course-benchmark": "uv run python -m scripts.draft_cross_course_benchmark",
    "verify:cross-course-benchmark": "uv run python -m scripts.validate_cross_course_benchmark --synthetic --schema-only",
    "verify:multimodal-retrieval-instruments": "uv run python -m scripts.validate_multimodal_retrieval_dataset",
    "inventory:multimodal-sources": "uv run python -m scripts.inventory_multimodal_sources",
    "sample:multimodal-pdf-pages": "uv run python -m scripts.sample_multimodal_pdf_pages",
    "draft:multimodal-private-benchmark": "uv run python -m scripts.build_multimodal_private_draft",
    "apply:multimodal-private-review": "uv run python -m scripts.apply_multimodal_researcher_review",
    "seal:multimodal-private-benchmark": "uv run python -m scripts.seal_multimodal_benchmark",
    "build:multimodal-development-artifacts": "uv run python -m scripts.build_multimodal_development_artifacts",
    "benchmark:multimodal-development": "uv run python -m scripts.run_multimodal_retrieval_development",
    "review:multimodal-private-claude": "uv run python -m scripts.second_review_multimodal_benchmark --consumer-data-boundary-approved",
    "verify:evaluation-instruments": "uv run python -m scripts.validate_evaluation_instruments",
    "verify:retrieval-v3-instruments": "uv run python -m scripts.validate_retrieval_v3_instruments",
    "verify:evaluation-results": "uv run python -m scripts.validate_evaluation_results",
    "verify:retrieval": "uv run python -m scripts.evaluate_retrieval",
    "benchmark:retrieval": "uv run --extra retrieval-benchmark python -m scripts.benchmark_retrieval --output reports/generated/retrieval-v2.json",
    "qualify:retrieval-provider-local": "uv run --extra retrieval-benchmark python -m scripts.run_cross_course_retrieval_qualification --provider-pair local-qwen3-0-6b",
    "qualify:retrieval-provider-jina": "uv run python -m scripts.run_cross_course_retrieval_qualification --provider-pair hosted-jina-text-v5-reranker-v3",
    "benchmark:retrieval-deployability-local": "uv run --extra retrieval-benchmark python -m scripts.run_cross_course_retrieval_qualification --provider-pair local-qwen3-0-6b --embedding-batch-size 16 --reranking-batch-size 8 --reranking-max-length 1024 --output-root experiments/runs/cross_course_retrieval_deployability_v1",
    "benchmark:retrieval-deployability-depth20": "uv run --extra retrieval-benchmark python -m scripts.run_cross_course_retrieval_qualification --provider-pair local-qwen3-0-6b --embedding-batch-size 16 --reranking-batch-size 8 --reranking-max-length 1024 --rerank-candidate-limit 20 --output-root experiments/runs/cross_course_retrieval_deployability_v1_depth20",
    "analyze:retrieval-provider-local": "uv run --extra retrieval-benchmark python -m scripts.analyze_cross_course_provider_result",
    "calibrate:evidence-sufficiency": "uv run --extra retrieval-benchmark python -m scripts.benchmark_evidence_sufficiency --calibration-only",
    "benchmark:evidence-sufficiency": "uv run --extra retrieval-benchmark python -m scripts.benchmark_evidence_sufficiency --output reports/generated/evidence-sufficiency-v1.json",
    "test:web": "npm --workspace apps/web run test -- --run",
    "build:web": "npm --workspace apps/web run build",
    "lint:web": "npm --workspace apps/web run lint"
  }
}
