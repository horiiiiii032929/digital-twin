# Exact non-secret runtime selectors for the qualified local R1 composition.
# Copy to the ignored repository-root .env.local-r1 and replace every secret.
LOCAL_R1_HTTPS_PORT=8443
APP_IMAGE_TAG=r1-local-qualification-006
APP_LEARNING_GAP_HMAC_SECRET=replace-with-at-least-32-random-bytes
APP_GENERATOR_MODE=deterministic
APP_EVIDENCE_GATE_MODE=dominance-scoped-ambiguity-safe-v3
APP_STUDENT_PROFILE_PATH=/app/research/05_evaluation/profiles/student-tutor-r1-local-candidate-v3.json
APP_STUDENT_TUTORING_MODE=governed-autonomous-tutoring-graph-v2.1
APP_AUTONOMY_PLANNER_MODE=openai-gpt-5.6-luna-policy-value
APP_T1_QUALIFICATION_RESULT_PATH=/app/research/05_evaluation/records/governed-full-autonomy-v2-1-release-binding-correction-001.json
APP_PROVIDER_MAX_CALLS_PER_PROCESS=250
APP_PROVIDER_COST_CAP_USD=5.0
OPENAI_API_KEY=

# Used only by the local bootstrap and acceptance verifier.
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-local-password
STAGING_ADMIN_PASSWORD=replace-with-the-same-admin-password
STAGING_PROFESSOR_PASSWORD=replace-with-a-strong-local-password
STAGING_STUDENT_PASSWORD=replace-with-a-strong-local-password
