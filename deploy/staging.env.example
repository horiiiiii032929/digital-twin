# Copy to a private file outside Git or to .env.staging in the repository.
# Point APP_DOMAIN to this host before starting Caddy so it can obtain TLS.
APP_DOMAIN=twin.example.edu
TLS_EMAIL=operator@example.edu

# Runtime limits. These defaults are intentionally conservative for the pilot.
APP_SESSION_TTL_SECONDS=28800
APP_MAX_UPLOAD_BYTES=52428800
APP_MAX_OBJECT_STORE_BYTES=5368709120
APP_LOGIN_ATTEMPTS_PER_MINUTE=10
APP_AUTHENTICATED_REQUESTS_PER_MINUTE=120
APP_LOG_LEVEL=INFO
APP_GENERATOR_MODE=deterministic
APP_STUDENT_PROFILE_PATH=/app/research/05_evaluation/profiles/student-tutor-r1-openai-candidate-v1.json
# T1 is intentionally rejected by staging validation until issue #107 passes.
APP_STUDENT_TUTORING_MODE=grounded-assistant
APP_PROACTIVE_OUTREACH_WORKER_ENABLED=false
# Required when T1 and privacy-minimized learning-gap emission are enabled.
APP_LEARNING_GAP_HMAC_SECRET=
APP_T1_QUALIFICATION_RESULT_PATH=
APP_PROVIDER_MAX_CALLS_PER_PROCESS=1000
APP_PROVIDER_COST_CAP_USD=5.00

# Required only after APP_GENERATOR_MODE=openai-gpt-5.4-mini is separately
# selected. Keep the replacement key in this untracked deployment environment.
OPENAI_API_KEY=

# Used only for the one-time administrator bootstrap command. Rotate/remove it
# from the environment immediately after provisioning.
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-random-password-of-at-least-12-characters
