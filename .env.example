# Copy this file to .env and replace the placeholder locally. Revoke any key
# that has appeared in chat, source control, a screenshot, or a log.
# Never commit .env or paste the replacement credential into documentation/chat.
OPENAI_API_KEY=replace_with_your_new_local_openai_api_key
# Optional prospective true-visual retrieval provider. Keep empty unless the
# ColPali-style checkpoint is explicitly selected for local evaluation.
JINA_API_KEY=

# Local product mode. Keep demo for the existing synthetic walkthrough.
APP_MODE=demo
VITE_AUTH_MODE=demo

# Staging generation remains on the deterministic rollback until the 500-case
# OpenAI development checkpoint passes and receives a separate selection.
APP_GENERATOR_MODE=deterministic
APP_EVIDENCE_GATE_MODE=unselected
APP_STUDENT_PROFILE_PATH=research/05_evaluation/profiles/student-tutor-r1-local-candidate-v1.json
# T0 remains the release-safe default. The qualified local release overrides
# this to T1 only with hash-bound confirmation evidence and keeps T0 as rollback.
APP_STUDENT_TUTORING_MODE=grounded-assistant
APP_AUTONOMY_PLANNER_MODE=deterministic
# The H+E1 confirmation candidate uses
# openai-gpt-5.6-luna-policy-value. Keep deterministic until the fresh
# whole-system result is bound to a qualification record.
APP_PROACTIVE_OUTREACH_WORKER_ENABLED=false
# Required for a qualified T1 preview. Generate at least 32 random bytes and
# keep the real value only in the ignored .env.
APP_LEARNING_GAP_HMAC_SECRET=
APP_T1_QUALIFICATION_RESULT_PATH=
APP_PROVIDER_MAX_CALLS_PER_PROCESS=1000
APP_PROVIDER_COST_CAP_USD=5.0
APP_VISUAL_RETRIEVAL_MODE=text-ocr-fallback
APP_VISUAL_QUERY_TIMEOUT_SECONDS=8.0
APP_VISUAL_COMPONENT_LEDGER_SHA256=
APP_MAX_OBJECT_STORE_BYTES=5368709120
