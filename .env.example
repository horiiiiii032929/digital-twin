# Copy this file to .env and replace the placeholder locally.
# Never commit .env or paste the credential into documentation or chat.
DEEPSEEK_API_KEY=replace_with_your_local_deepseek_api_key

# Optional controlled gateway for prospective multi-model evaluation. Direct
# DeepSeek remains the selected path until the OpenRouter route is qualified.
OPENROUTER_API_KEY=replace_with_your_local_openrouter_api_key

# Local product mode. Keep demo for the existing synthetic walkthrough.
APP_MODE=demo
VITE_AUTH_MODE=demo

# Staging generation defaults to the deterministic rollback. The selected
# DeepSeek binding is activated only with APP_GENERATOR_MODE=deepseek-v4-flash.
APP_GENERATOR_MODE=deterministic
# T0 remains the release-safe default. T1 is build-only and accepted only in
# local demo/test mode until its multi-turn confirmation is recorded.
APP_STUDENT_TUTORING_MODE=grounded-assistant
APP_PROVIDER_MAX_CALLS_PER_PROCESS=1000
APP_PROVIDER_COST_CAP_USD=5.0
APP_MAX_OBJECT_STORE_BYTES=5368709120
